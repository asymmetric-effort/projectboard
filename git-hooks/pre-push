#!/usr/bin/env bash
set -euo pipefail

echo "==> pre-push: typecheck (ui)"
(cd ui && npx tsc --noEmit)

echo "==> pre-push: typecheck (api)"
(cd api && npx tsc --noEmit)

echo "==> pre-push: lint (ui)"
(cd ui && npx prettier --check src/)

echo "==> pre-push: lint (api)"
(cd api && npx prettier --check src/)

echo "==> pre-push: test (ui)"
(cd ui && npm test)

echo "==> pre-push: test (api)"
(cd api && npm test)

echo "==> pre-push: audit (ui)"
(cd ui && npm audit --audit-level=moderate || true)

echo "==> pre-push: audit (api)"
(cd api && npm audit --audit-level=moderate || true)
